{"title":"Body","body":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["data"],"properties":{"data":{"type":"array","minItems":1,"maxItems":500,"items":{"type":"object","required":["invoice","recipient_name","recipient_phone","recipient_address","cod_amount"],"properties":{"invoice":{"type":"string","maxLength":100,"description":"Unique merchant invoice reference.","example":"INV-1001"},"recipient_name":{"type":"string","maxLength":100,"example":"Nadia Rahman"},"recipient_phone":{"type":"string","pattern":"^01[3-9][0-9]{8}$","example":"01711111111"},"recipient_address":{"type":"string","maxLength":250,"example":"House 17, Road 3/A, Dhanmondi, Dhaka"},"cod_amount":{"type":"number","minimum":0,"description":"Cash-on-delivery amount in BDT.","example":1290},"note":{"type":"string","nullable":true,"example":"Deliver before 3 PM"},"item_description":{"type":"string","nullable":true,"example":"Cotton panjabi"},"total_lot":{"type":"integer","minimum":1,"default":1},"delivery_type":{"type":"integer","enum":[0,1],"default":0,"description":"0 for home delivery, 1 for hub pickup."}},"title":"CreateOrderRequest"}}}}}}}}